{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "test-schema-prodshape",
  "main": "test/harness/schema-worker.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": false },
  "_comment": "Test-only. Runs the D1 schema into the production-shape local database.",
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bludit-wizard-mcp-test-prodshape",
      "database_id": "test-d1-database-prodshape"
    }
  ]
}
