# npm 10.9.x ships an arborist bug that crashes with
#   "TypeError: Cannot read properties of null (reading 'edgesOut')"
# while resolving the peer-dependency set of vitest's dependency tree.
# See docs/DEPLOYMENT.md ("Toolchain notes") for the reproduction and for how
# to confirm the bug is gone in a newer npm and remove this file.
legacy-peer-deps=true

# Lockfiles are the reproducibility boundary here; do not rewrite them silently.
package-lock=true
save-exact=true
