{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bludit-wizard-auth",
  "main": "src/auth/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": false },
  "vars": {
    "AUTH_ISSUER": "http://127.0.0.1:8787",
    "MCP_RESOURCE": "http://127.0.0.1:8788/mcp",
    "ALLOW_INSECURE_SITE_URLS": "true",
        "ALLOW_SIGNUP": "true",
    "_rate_limit_comment": "Disabled for tests that are not about rate limiting, so their behaviour does not depend on production defaults. test/integration/rate-limit.test.ts enables it explicitly with tight per-bucket values.",
    "RATE_LIMIT_ENABLED": "false",
    "PBKDF2_ITERATIONS": "1000",
    "PAIRING_TTL_SECONDS": "900",
    "PROPOSAL_TTL_SECONDS": "900",
    "SITE_CREDENTIAL_KEY": "XlyeP38PtmqkrXQqxoIEKKl014GoRzewkOw1FGeZF+w=",
    "SESSION_SECRET": "xFKQYD1Q6T1sfB9Uu2VxYOCyl3+05Un+QnH4EnQ6/R8=",
    "CONSENT_SECRET": "mfBcuEtFLcksbYm6tFjzy58WqE3+Mh7fGPiX346Rr2w="
  },
  "_comment": "Test-only config. Deliberately omits the global_fetch_strictly_public flag so the Workers can reach the loopback mock Bludit server. Never deploy this file.",
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "test-oauth-kv" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bludit-wizard-mcp-test",
      "database_id": "test-d1-database",
      "migrations_dir": "migrations"
    }
  ]
}
